{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Ocelot": "Information"
    }
  },
  "AllowedHosts": "*",
  "Ocelot": {
    "Routes": [
      {
        "DownstreamPathTemplate": "/api/Auth/register",
        "DownstreamScheme": "http",
        "DownstreamHostAndPorts": [
          {
            "Host": "auth-service",
            "Port": 80
          }
        ],
        "UpstreamPathTemplate": "/api/auth/register",
        "UpstreamHttpMethod": [ "POST" ]
      },
      {
        "DownstreamPathTemplate": "/api/login",
        "DownstreamScheme": "http",
        "DownstreamHostAndPorts": [
          {
            "Host": "auth-service",
            "Port": 80
          }
        ],
        "UpstreamPathTemplate": "/api/auth/login",
        "UpstreamHttpMethod": [ "POST" ]
      },
      {
        "DownstreamPathTemplate": "/api/profile",
        "DownstreamScheme": "http",
        "DownstreamHostAndPorts": [
          {
            "Host": "auth-service",
            "Port": 80
          }
        ],
        "UpstreamPathTemplate": "/api/auth/profile",
        "UpstreamHttpMethod": [ "GET" ]
      },
      {
        "DownstreamPathTemplate": "/api/me",
        "DownstreamScheme": "http",
        "DownstreamHostAndPorts": [
          {
            "Host": "auth-service",
            "Port": 80
          }
        ],
        "UpstreamPathTemplate": "/api/auth/me",
        "UpstreamHttpMethod": [ "GET" ]
      },
      {
        "DownstreamPathTemplate": "/api/logout",
        "DownstreamScheme": "http",
        "DownstreamHostAndPorts": [
          {
            "Host": "auth-service",
            "Port": 80
          }
        ],
        "UpstreamPathTemplate": "/api/auth/logout",
        "UpstreamHttpMethod": [ "POST" ]
      },
      {
        "DownstreamPathTemplate": "/api/refresh-token",
        "DownstreamScheme": "http",
        "DownstreamHostAndPorts": [
          {
            "Host": "auth-service",
            "Port": 80
          }
        ],
        "UpstreamPathTemplate": "/api/auth/refresh-token",
        "UpstreamHttpMethod": [ "POST" ]
      },
      {
        "DownstreamPathTemplate": "/api/{everything}",
        "DownstreamScheme": "http",
        "DownstreamHostAndPorts": [
          {
            "Host": "account-ownership-service",
            "Port": 80
          }
        ],
        "UpstreamPathTemplate": "/api/account/{everything}",
        "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ]
      },
      {
        "DownstreamPathTemplate": "/api/{everything}",
        "DownstreamScheme": "http",
        "DownstreamHostAndPorts": [
          {
            "Host": "booking-service",
            "Port": 80
          }
        ],
        "UpstreamPathTemplate": "/api/booking/{everything}",
        "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ]
      },
      {
        "DownstreamPathTemplate": "/api/{everything}",
        "DownstreamScheme": "http",
        "DownstreamHostAndPorts": [
          {
            "Host": "history-service",
            "Port": 80
          }
        ],
        "UpstreamPathTemplate": "/api/history/{everything}",
        "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ]
      },
      {
        "DownstreamPathTemplate": "/api/{everything}",
        "DownstreamScheme": "http",
        "DownstreamHostAndPorts": [
          {
            "Host": "group-service",
            "Port": 80
          }
        ],
        "UpstreamPathTemplate": "/api/group/{everything}",
        "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ]
      },
      {
        "DownstreamPathTemplate": "/api/{everything}",
        "DownstreamScheme": "http",
        "DownstreamHostAndPorts": [
          {
            "Host": "admin-service",
            "Port": 80
          }
        ],
        "UpstreamPathTemplate": "/api/admin/{everything}",
        "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ]
      }
    ],
    "GlobalConfiguration": {
      "BaseUrl": "http://localhost:8000",
      "RateLimitOptions": {
        "DisableRateLimitHeaders": false,
        "QuotaExceededMessage": "Rate limit exceeded",
        "HttpStatusCode": 429
      }
    },
    "SwaggerEndPoints": [
      {
        "Key": "auth",
        "Config": [
          {
            "Name": "Auth Service API",
            "Version": "v1",
            "Url": "http://auth-service/swagger/v1/swagger.json"
          }
        ]
      },
      {
        "Key": "account",
        "Config": [
          {
            "Name": "Account Service API",
            "Version": "v1",
            "Url": "http://account-ownership-service/swagger/v1/swagger.json"
          }
        ]
      },
      {
        "Key": "booking",
        "Config": [
          {
            "Name": "Booking Service API",
            "Version": "v1",
            "Url": "http://booking-service/swagger/v1/swagger.json"
          }
        ]
      },
      {
        "Key": "history",
        "Config": [
          {
            "Name": "History Service API",
            "Version": "v1",
            "Url": "http://history-service/swagger/v1/swagger.json"
          }
        ]
      },
      {
        "Key": "group",
        "Config": [
          {
            "Name": "Group Service API",
            "Version": "v1",
            "Url": "http://group-service/swagger/v1/swagger.json"
          }
        ]
      },
      {
        "Key": "admin",
        "Config": [
          {
            "Name": "Admin Service API",
            "Version": "v1",
            "Url": "http://admin-service/swagger/v1/swagger.json"
          }
        ]
      }
    ]
  },
  "JWT": {
    "Secret": "change_this_to_a_strong_secret_key_for_production_use_only",
    "Issuer": "EV-CoOwnership-System",
    "Audience": "EV-CoOwnership-Users"
  }
}
